# Copy to .env.local (web) or .env (contracts). Never commit real values.

# Deployer key, used only for one forge command at a time (pass via env, do not save).
PRIVATE_KEY=
# Demo wallet A (BTC seller). Demo scripts only.
W1_KEY=
# Demo wallet B (MUSD seller, opens the trove). Demo scripts only.
W2_KEY=
# Demo wallet C (MUSD seller). Demo scripts only.
W3_KEY=
# Deployed IntentBook address on Mezo testnet (chain 31611).
NEXT_PUBLIC_INTENT_BOOK=
# Deployed PriceGuard address.
NEXT_PUBLIC_PRICE_GUARD=
# Deployed BatchSettler address.
NEXT_PUBLIC_BATCH_SETTLER=
# Bearer secret that Supabase cron sends to /api/settle. Server only.
SETTLE_SECRET=
# Hot wallet for the optional keeper route (holds a small amount of BTC). Server only.
KEEPER_PRIVATE_KEY=
